# Destino de los leads del formulario de contacto y de la suscripción.
# Puede ser un incoming webhook de Slack, un endpoint de HubSpot o una función
# propia. Recibe un POST con JSON:
#   { topic, email, name, organization, message, locale, receivedAt, source }
#
# Sin esta variable, /api/contact responde 501 a propósito y el formulario
# muestra el mail directo en vez de fingir que envió.
CONTACT_WEBHOOK_URL=
